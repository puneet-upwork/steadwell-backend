DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/steadwell?sslmode=disable
HTTP_PORT=8080
ADMIN_ORIGIN=http://127.0.0.1:5173
# AES-GCM key for per-org channel secrets (32 bytes). Generate: openssl rand -base64 32
CHANNEL_CREDS_KEY=
# Inbound Telegram webhook (platform bot). Join QR uses each org’s saved fields, not these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_BUSINESS_NUMBER=
LINE_LIFF_URL=
# LiteLLM OpenAI-compat (Eino chat). Unset BaseURL or Model → Echo fallback.
# Start proxy: see deploy/litellm/README.md (docker compose up -d)
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=sk-steadwell-local
LITELLM_MODEL=deepseek
